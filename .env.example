# ==========================================
# SMART CANTEEN PLATFORM CONFIGURATION
# ==========================================

# Project Info
PROJECT_NAME="Smart Canteen Orchestration System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Secrets
SECRET_KEY="smart_canteen_super_secure_jwt_secret_key_2026_campus_auth"
QR_SECRET_KEY="smart_canteen_hmac_qr_signature_key_for_pickup_tokens_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-setup, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./smart_canteen.db"
SYNC_DATABASE_URL="sqlite:///./smart_canteen.db"

# Kitchen Orchestration & Operational Constants
DEFAULT_KITCHEN_ACTIVE_STATIONS=4
KITCHEN_THROUGHPUT_PER_STATION_PER_MIN=0.35
BASE_TRANSITION_BUFFER_MINUTES=2

# Queue Fair Aging Weights
WEIGHT_WAITING_TIME=0.50
WEIGHT_DEADLINE_URGENCY=0.30
WEIGHT_PREP_COMPLEXITY=0.20
AGING_BONUS_PER_MINUTE=1.25

# Peak Load Thresholds
PEAK_BUSY_ACTIVE_ORDERS=15
PEAK_HIGH_ACTIVE_ORDERS=30
PEAK_CRITICAL_ACTIVE_ORDERS=45

# Frontend URLs
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
